{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "vite/client"],
    "paths": { "@/*": ["./src/web/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "alchemy.ts", "alchemy.run.ts", "alchemy.test.ts", "vite.config.ts"]
}
