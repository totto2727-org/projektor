{
	"name": "projektor",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vp run dev:stack",
		"build": "vp run build:packages",
		"type-check": "vp run check:types",
		"test": "vp run test:packages",
		"lint": "vp lint && vp fmt --check",
		"lint:fix": "vp lint --fix && vp fmt",
		"format": "vp fmt",
		"gen:docs": "pnpm --filter @projektor/api gen:catalog && pnpm --filter @projektor/api gen:workflow-spec && pnpm --filter @projektor/api gen:playbooks && tsx scripts/gen-conventions-page.ts && tsx scripts/gen-feedback-example-page.ts"
	},
	"devDependencies": {
		"@alchemy.run/cloudflare-runtime": "2.0.0-beta.79",
		"@cloudflare/workers-types": "^5.20260813.1",
		"@distilled.cloud/cloudflare": "1.0.0-rc.12",
		"@effect/platform-node": "4.0.0-rc.116",
		"@playwright/test": "1.62.1",
		"@types/node": "24.13.3",
		"alchemy": "2.0.0-beta.79",
		"effect": "4.0.0-rc.116",
		"tsx": "^4.23.12",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1"
	},
	"engines": {
		"node": ">=22.18",
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@10.18.0",
	"pnpm": {
		"overrides": {
			"@effect/platform-node-shared": "4.0.0-rc.116",
			"typescript": "6.0.3",
			"@types/node": "24.13.3",
			"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
		}
	}
}
