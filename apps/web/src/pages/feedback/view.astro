---
import Base from '../../layouts/Base.astro';
import ProjectNav from '../../islands/ProjectNav';
import FeedbackSourceDetail from '../../islands/FeedbackSourceDetail';

// Source ID and project ID are read from ?sourceId=/&projectId= at runtime by the island
// (static output cannot use dynamic routes). Source identity and ProjectNav's
// project identity are separate; ?id= here is not a project hint.
---
<Base title="Feedback source — Projektor">
  <ProjectNav client:load pageLabel="Feedback" />
  <div class="page-container">
    <FeedbackSourceDetail client:load />
  </div>
</Base>
