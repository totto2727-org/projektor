{
  "name": "projektor",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "type-check": "turbo type-check",
    "deploy": "turbo deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "gen:docs": "bun run --filter @projektor/api gen:catalog && bun run --filter @projektor/api gen:workflow-spec && bun run --filter @projektor/api gen:playbooks && tsx scripts/gen-conventions-page.ts && tsx scripts/gen-feedback-example-page.ts",
    "bundle-budget": "tsx scripts/bundle-budget.ts",
    "bundle-budget:update": "tsx scripts/bundle-budget.ts --update",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@biomejs/cli-win32-x64": "^2.5.15",
    "@cloudflare/workers-types": "^5.20261008.1",
    "lefthook": "^2.2.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "trustedDependencies": ["esbuild", "lefthook", "sharp", "workerd"],
  "engines": {
    "node": ">=22.12",
    "bun": ">=1.3.13"
  }
}
