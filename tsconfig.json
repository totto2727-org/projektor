{
  "extends": ["@tsconfig/strictest/tsconfig.json", "@tsconfig/node-ts/tsconfig.json"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "vite/client"],
    "paths": { "@/*": ["./src/web/*"] }
  },
  "exclude": [
    "**/node_modules",
    "tmp",
    "**/dist",
    "**/core-dist",
    "**/test-results",
    "**/playwright-report",
    "tests/e2e-alchemy/discovery-audited"
  ]
}
